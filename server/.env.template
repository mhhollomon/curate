# When installing, copy this file to .env and edit
# DO NOT COMMIT TO THE REPO!!!

# This is the top level of the directory structure you want
# to serve.
MUSIC_DIRECTORY="/mnt/somepath"

# Path to ffmpeg
# Defaults to "/usr/bin/ffmpeg" which is the normal Linux path
#FFMPEG_PATH="/usr/bin/ffmpeg"

# Cache path
# Directory that the server will use to cache various
# transcodings (both audio and picture).
# This need to be writable by the server.
CACHE_PATH="cache/"

# Path and name of the sqlite database file.
# This needs to be writable by the server.
DB_FILE="/some/path/filename.db"

# Secret used to encrypt the cookies/tokens generated.
# use something like :
#  python -c "import secrets; print(secrets.token_hex(24))"
# to generate the secret.
SECRET="some cool string"